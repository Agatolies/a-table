# Générer les deux secrets avec npm run setup, ou openssl rand -hex 32.
# Ne jamais committer .env. PUBLIC_URL doit correspondre exactement à l'URL du navigateur.
PUBLIC_URL=http://localhost:8080
BIND_ADDRESS=127.0.0.1
HTTP_PORT=8080
ADMIN_PASSWORD=
SESSION_SECRET=
ATABLE_IMAGE=ghcr.io/agatolies/a-table:latest
